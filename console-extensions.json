[
  {
    "type": "console.page/route",
    "properties": {
      "exact": true,
      "path": "/partner-labs-demos",
      "component": { "$codeRef": "DemosPage" }
    }
  },
  {
    "type": "console.page/route",
    "properties": {
      "path": "/partner-labs-demos/:demoId",
      "component": { "$codeRef": "CookbookPage" }
    }
  },
  {
    "type": "console.navigation/href",
    "properties": {
      "id": "partner-labs-demos",
      "name": "%plugin__partner-labs-console-plugin~Partner Labs Demos%",
      "href": "/partner-labs-demos",
      "perspective": "admin",
      "insertBefore": "home"
    }
  }
]
